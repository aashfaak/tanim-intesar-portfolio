rules_version = '2';

// Copy these into Firebase console → Firestore Database → Rules, and
// publish. They allow anyone to read content (so the public site works)
// but only a signed-in user (your one admin account) to create, edit, or
// delete anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
