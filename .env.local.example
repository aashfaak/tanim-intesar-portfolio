# Copy this file to .env.local and fill in your Firebase project's web app
# config. Find these values in the Firebase console:
# Project settings (gear icon) → General → Your apps → SDK setup and config.
#
# These are safe to expose to the browser (that's what NEXT_PUBLIC_ means) —
# Firebase's actual security is enforced by your Firestore rules and Auth
# settings, not by hiding these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
